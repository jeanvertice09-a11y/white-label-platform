# ============================================================
# White-Label Platform — .env.example (SEM segredos reais)
# Copie para .env e preencha localmente. Nunca commite .env.
# ============================================================

# ---- App ----
NODE_ENV=development
APP_ENV=local
WEB_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5173

# ---- Supabase (valores de EXEMPLO — use `supabase start` local) ----
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.EXAMPLE_ANON_KEY_DO_NOT_USE
# ATENÇÃO: service role SOMENTE server-side (worker / server-only). Jamais prefixar com VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Públicas (prefixo VITE_ expõe ao browser — NUNCA segredo) ----
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.EXAMPLE_ANON_KEY_DO_NOT_USE
VITE_APP_ENV=local

# ---- R2 (somente server-side) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=white-label-media
R2_PUBLIC_BASE_URL=https://media.kataluu.com.br

# ---- Domains (somente server-side; destino DNS REAL da infraestrutura) ----
# Sem este valor o onboarding permanece PENDING e informa configuração indisponível.
DOMAIN_CNAME_TARGET=

# ---- Gateway credential vault (somente server-side; keyring versionado) ----
GATEWAY_CREDENTIAL_VAULT_KEYS=

# ---- Payments (sandbox; aguardando integração) ----
MERCADOPAGO_ACCESS_TOKEN=
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Escritas platform_billing só podem ser habilitadas fora de produção.
PLATFORM_BILLING_SANDBOX_WRITES=

# ---- Worker ----
WORKER_CONCURRENCY=5
WORKER_POLL_MS=1000

# ---- Testes REAL DATABASE (bun run test:db) ----
# Padrão: PGlite em-processo (sem config). Opcional: URL superuser de um
# PostgreSQL servidor/Supabase local para rodar a mesma suíte no servidor.
TEST_DATABASE_URL=
