# ============================================================
# White-Label Platform — .env.example (SEM segredos reais)
# Copie para .env e preencha localmente. Nunca commite .env.
# ============================================================

# ---- App ----
NODE_ENV=development
APP_ENV=local
WEB_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5173

# ---- Supabase (valores de EXEMPLO — use `supabase start` local) ----
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.EXAMPLE_ANON_KEY_DO_NOT_USE
# ATENÇÃO: service role SOMENTE server-side (worker / server-only). Jamais prefixar com VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Públicas (prefixo VITE_ expõe ao browser — NUNCA segredo) ----
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.EXAMPLE_ANON_KEY_DO_NOT_USE
VITE_APP_ENV=local

# ---- R2 (somente server-side; aguardando conta real) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=
R2_PUBLIC_BASE_URL=

# ---- Payments (sandbox; aguardando integração) ----
MERCADOPAGO_ACCESS_TOKEN=
ASAAS_API_KEY=
ASAAS_ENV=sandbox

# ---- Worker ----
WORKER_CONCURRENCY=5
WORKER_POLL_MS=1000
