{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "baseUrl": ".",
    "paths": {
      "@white-label/audit": [
        "./packages/audit/src/index.ts"
      ],
      "@white-label/auth": [
        "./packages/auth/src/index.ts"
      ],
      "@white-label/billing": [
        "./packages/billing/src/index.ts"
      ],
      "@white-label/catalog": [
        "./packages/catalog/src/index.ts"
      ],
      "@white-label/database": [
        "./packages/database/src/index.ts"
      ],
      "@white-label/domains": [
        "./packages/domains/src/index.ts"
      ],
      "@white-label/payments": [
        "./packages/payments/src/index.ts"
      ],
      "@white-label/payments/server": [
        "./packages/payments/src/server.ts"
      ],
      "@white-label/orders": [
        "./packages/orders/src/index.ts"
      ],
      "@white-label/inventory": [
        "./packages/inventory/src/index.ts"
      ],
      "@white-label/customers": [
        "./packages/customers/src/index.ts"
      ],
      "@white-label/marketing": [
        "./packages/marketing/src/index.ts"
      ],
      "@white-label/platform": [
        "./packages/platform/src/index.ts"
      ],
      "@white-label/storage": [
        "./packages/storage/src/index.ts"
      ],
      "@white-label/storage/server": [
        "./packages/storage/src/server.ts"
      ],
      "@white-label/stores": [
        "./packages/stores/src/index.ts"
      ],
      "@white-label/tenant": [
        "./packages/tenant/src/index.ts"
      ],
      "@white-label/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@white-label/validation": [
        "./packages/validation/src/index.ts"
      ]
    },
    "types": [
      "bun"
    ]
  },
  "include": [
    "apps/*/src/**/*",
    "packages/*/src/**/*",
    "tests/**/*",
    "scripts/**/*.ts",
    "supabase/**/*.ts",
    "vite.config.*",
    "apps/*/vite.config.*",
    "apps/*/app.config.ts",
    "playwright.config.ts",
    "eslint.config.*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "**/dist/**"
  ]
}
