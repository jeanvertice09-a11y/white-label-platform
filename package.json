{
  "name": "white-label-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma SaaS White-Label Multi-Tenant — fundação (modular monolith)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '@white-label/web' dev",
    "dev:worker": "bun --filter '@white-label/worker' dev",
    "build": "bun run build:packages && bun run build:web && bun run build:worker",
    "build:packages": "tsc --noEmit -p tsconfig.json",
    "build:web": "bun --filter '@white-label/web' build",
    "build:worker": "bun --filter '@white-label/worker' build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test tests/unit packages/*/src --timeout 10000",
    "test:integration": "bun test tests/integration --timeout 15000",
    "test:db": "bun test tests/db --timeout 120000",
    "test:security": "bun test tests/security --timeout 15000",
    "test:all": "bun test tests/unit tests/integration tests/security packages/*/src --timeout 15000",
    "test:e2e": "bun tests/e2e/smoke.ts",
    "homologation:plan": "bun scripts/homologation/cli.ts plan",
    "homologation:assets": "bun scripts/homologation/cli.ts assets",
    "homologation:preflight": "bun scripts/homologation/cli.ts preflight",
    "homologation:preflight:functional": "bun scripts/homologation/cli.ts preflight",
    "homologation:preflight:production": "bun scripts/homologation/cli.ts preflight-production",
    "homologation:apply": "bun scripts/homologation/cli.ts apply",
    "homologation:apply:functional": "bun scripts/homologation/cli.ts apply-functional",
    "homologation:cleanup": "bun scripts/homologation/cli.ts cleanup"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  }
}
